# Smartschool accounts are not stored in this file.
# Use ~/.config/smartschool/credentials.json (or $GROK_PLUGIN_DATA/credentials.json).
# The MCP server, Claude plugin, and Grok plugin share that file.
# A complete SMARTSCHOOL_* environment overrides one process.
# An old .env with those variables is copied into the shared file once
# when that file does not exist yet.

# Remote HTTP transport
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional: protect the /mcp endpoint with a Bearer token
# Set the same value in claude.ai when adding the custom connector
# MCP_API_KEY=change-me-to-a-long-random-secret

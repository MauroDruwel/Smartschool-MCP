{
  "manifest_version": "0.4",
  "name": "smartschool-mcp",
  "display_name": "Smartschool",
  "version": "0.2.0",
  "description": "Rooster, punten, taken en berichten van Smartschool voor één kind.",
  "long_description": "Claude Desktop-extensie voor het Smartschool-portaal. Je vult bij het installeren de school, de gebruikersnaam, het wachtwoord, de geboortedatum en de naam van je kind in. De server start via uv en praat via stdio. Het Smartschool-account zelf wordt niet in een tweede config-bestand bewaard.",
  "author": {
    "name": "Mauro Druwel",
    "email": "mauro.druwel@gmail.com",
    "url": "https://github.com/MauroDruwel/Smartschool-MCP"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MauroDruwel/Smartschool-MCP"
  },
  "homepage": "https://github.com/MauroDruwel/Smartschool-MCP",
  "documentation": "https://github.com/MauroDruwel/Smartschool-MCP/blob/main/docs/claude-desktop-test.md",
  "support": "https://github.com/MauroDruwel/Smartschool-MCP/issues",
  "server": {
    "type": "uv",
    "entry_point": "smartschool_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "smartschool_mcp"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "SMARTSCHOOL_MAIN_URL": "${user_config.school}",
        "SMARTSCHOOL_USERNAME": "${user_config.username}",
        "SMARTSCHOOL_PASSWORD": "${user_config.password}",
        "SMARTSCHOOL_MFA": "${user_config.birth_date}",
        "SMARTSCHOOL_CHILD_NAME": "${user_config.child_name}"
      }
    }
  },
  "tools": [
    {
      "name": "get_courses",
      "description": "Vakken met leerkrachten"
    },
    {
      "name": "get_results",
      "description": "Punten"
    },
    {
      "name": "get_future_tasks",
      "description": "Taken die nog moeten"
    },
    {
      "name": "get_messages",
      "description": "Berichten"
    },
    {
      "name": "get_schedule",
      "description": "Rooster van één dag"
    },
    {
      "name": "get_periods",
      "description": "Periodes van het schooljaar"
    },
    {
      "name": "get_reports",
      "description": "Rapporten"
    },
    {
      "name": "get_planned_elements",
      "description": "Planner over meerdere dagen"
    },
    {
      "name": "get_student_support_links",
      "description": "Links voor leerlingenbegeleiding"
    },
    {
      "name": "get_children",
      "description": "Kinderen op Mijn kinderen"
    },
    {
      "name": "switch_child",
      "description": "Wissel naar een gekoppeld kind"
    },
    {
      "name": "get_attachments",
      "description": "Bijlagen bij een bericht"
    },
    {
      "name": "download_attachment",
      "description": "Download een bijlage"
    },
    {
      "name": "get_homepage_blocks",
      "description": "Blokken in de kijker op de startpagina"
    },
    {
      "name": "download_homepage_image",
      "description": "Download een foto uit een startpaginablok"
    }
  ],
  "keywords": ["smartschool", "school", "planner", "cijfers"],
  "license": "MIT",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "user_config": {
    "school": {
      "type": "string",
      "title": "School",
      "description": "Het eerste stuk van het Smartschool-adres, bijvoorbeeld dering. .smartschool.be zetten we er zelf achter. Plak je het hele adres (ook met https://), dan halen we dat eraf.",
      "required": true
    },
    "username": {
      "type": "string",
      "title": "Gebruikersnaam",
      "description": "De gebruikersnaam van het Smartschool-account.",
      "required": true
    },
    "password": {
      "type": "string",
      "title": "Wachtwoord",
      "description": "Het wachtwoord van dat account. Claude bewaart dit versleuteld.",
      "sensitive": true,
      "required": true
    },
    "birth_date": {
      "type": "string",
      "title": "Geboortedatum van je kind",
      "description": "De geboortedatum als JJJJ-MM-DD, bijvoorbeeld 2014-03-21. Smartschool vraagt die als controle bij het inloggen.",
      "sensitive": true,
      "required": true
    },
    "child_name": {
      "type": "string",
      "title": "Naam van je kind",
      "description": "De voornaam, zodat Claude het juiste kind kiest als er meerdere kinderen aan het account hangen.",
      "required": true
    }
  }
}
